generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Config {
  id              Int      @id @default(1)
  balance_inicial Decimal  @db.Decimal(12, 2)
  nombre_acreedor String
  moneda          String   @default("MXN")
  created_at      DateTime @default(now())
}

enum TipoMovimiento {
  RETIRO_PERSONAL
  RETIRO_NEGOCIO
  ABONO_PERSONAL
  ABONO_NEGOCIO
  FEE_BANCARIO
  ABONO_INTERES
  RETIRO_DUENO
  CREDITO_DUENO
  INTERES_PRESTAMO_100K
}

model Movimiento {
  id         Int            @id @default(autoincrement())
  tipo       TipoMovimiento
  monto      Decimal        @db.Decimal(12, 2)
  fecha      DateTime
  nota       String?
  created_at DateTime       @default(now())

  @@index([fecha])
  @@index([tipo])
}

enum TipoMovimientoNino {
  PAGO_PADRE
  RETIRO_NINO
  REGALO_DINERO
}

model Nino {
  id            Int              @id @default(autoincrement())
  nombre        String
  deuda_inicial Decimal          @db.Decimal(12, 2)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  movimientos   MovimientoNino[]

  @@index([nombre])
}

model MovimientoNino {
  id         Int                  @id @default(autoincrement())
  ninoId     Int
  nino       Nino                 @relation(fields: [ninoId], references: [id], onDelete: Cascade)
  tipo       TipoMovimientoNino
  monto      Decimal              @db.Decimal(12, 2)
  fecha      DateTime
  nota       String?
  created_at DateTime             @default(now())

  @@index([ninoId])
  @@index([fecha])
  @@index([tipo])
}
